  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A clear task action using the current theme’s dedicated blue button color.",
      "html": "<button class=\"ds-primary\">Track this product</button>",
      "css": ".ds-primary{font-family:var(--font-body);font-size:.875rem;line-height:1.4;font-weight:600;border-radius:var(--radius-control);padding:11px 20px;min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:9px;cursor:pointer;transition:background .16s,color .16s,border-color .16s;background:var(--button);color:var(--button-text);border:1px solid transparent}.ds-primary:hover:not(:disabled){background:var(--button-hover)}.ds-primary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}.ds-primary:active:not(:disabled){transform:translateY(1px)}.ds-primary:disabled{opacity:.6;cursor:wait}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A supporting action or safe dialog cancellation.",
      "html": "<button class=\"ds-secondary\">Cancel</button>",
      "css": ".ds-secondary{font-family:var(--font-body);font-size:.875rem;line-height:1.4;font-weight:600;border-radius:var(--radius-control);padding:11px 20px;min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:9px;cursor:pointer;transition:background .16s,color .16s,border-color .16s;background:var(--surface);color:var(--ink);border:1px solid var(--line)}.ds-secondary:hover:not(:disabled){background:var(--soft);border-color:var(--muted)}.ds-secondary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}.ds-secondary:active:not(:disabled){transform:translateY(1px)}.ds-secondary:disabled{opacity:.6;cursor:wait}"
    },
    {
      "name": "Quiet button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "A low-emphasis supporting action without an extra container.",
      "html": "<button class=\"ds-quiet\">Dismiss notice</button>",
      "css": ".ds-quiet{font-family:var(--font-body);font-size:.875rem;line-height:1.4;font-weight:600;border-radius:var(--radius-control);padding:11px 20px;min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:9px;cursor:pointer;transition:background .16s,color .16s,border-color .16s;padding:10px 12px;background:transparent;color:var(--muted);border:1px solid transparent}.ds-quiet:hover:not(:disabled){background:var(--soft);color:var(--ink)}.ds-quiet:focus-visible{outline:3px solid var(--accent);outline-offset:4px}.ds-quiet:disabled{opacity:.6;cursor:wait}"
    },
    {
      "name": "Labelled input",
      "kind": "input",
      "refersTo": "input",
      "description": "A native field with a contrasting boundary, associated context and explicit focus.",
      "html": "<label class=\"ds-label\" for=\"ds-product-url\">Product URL</label><input class=\"ds-input\" id=\"ds-product-url\" type=\"url\" aria-describedby=\"ds-url-help\" placeholder=\"https://retailer.com/product\"><small class=\"ds-help\" id=\"ds-url-help\">Use a direct HTTPS link to the exact product.</small>",
      "css": ".ds-label{display:block;font-family:var(--font-body);font-size:.875rem;font-weight:600;line-height:1.4;color:var(--ink);margin:22px 0 8px}.ds-input{font-family:var(--font-body);font-size:1rem;line-height:1.5;background:var(--surface);color:var(--ink);border:1px solid var(--control-line);border-radius:var(--radius-control);min-width:0;width:100%;min-height:48px;padding:11px 13px;transition:border-color .16s;caret-color:var(--accent)}.ds-input:hover{border-color:var(--muted)}.ds-input:focus{border-color:var(--accent);outline:2px solid var(--accent);outline-offset:2px}.ds-input::placeholder{color:var(--muted);opacity:1}.ds-input[aria-invalid=true]{border-color:var(--error)}.ds-input:disabled{opacity:.6;cursor:not-allowed}.ds-help{display:block;font-family:var(--font-body);color:var(--muted);font-size:.875rem;line-height:1.5;margin-top:7px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "description": "Named destinations with an observation-colored current underline.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#community\" aria-current=\"page\">Community</a><a href=\"#track\">Track a product</a><a href=\"#watchlist\">My watchlist</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:28px;flex-wrap:wrap}.ds-nav a{font-family:var(--font-body);position:relative;font-size:.875rem;font-weight:500;min-height:44px;display:flex;align-items:center;color:var(--muted);text-decoration:none}.ds-nav a:hover,.ds-nav a[aria-current=page]{color:var(--ink)}.ds-nav a[aria-current=page]:after{content:'';position:absolute;height:2px;left:0;right:0;bottom:1px;background:var(--accent)}.ds-nav a:focus-visible{outline:3px solid var(--accent);outline-offset:4px}"
    },
    {
      "name": "Observation state",
      "kind": "chip",
      "refersTo": "state-label",
      "description": "A real status identified by text and a small observation dot.",
      "html": "<span class=\"ds-state\"><span class=\"ds-dot\" aria-hidden=\"true\"></span>Tracking</span>",
      "css": ".ds-state{display:inline-flex;align-items:center;gap:7px;font-family:var(--font-body);font-size:.75rem;line-height:1.4;font-weight:500;padding:6px 8px;border-radius:4px;background:var(--soft);color:var(--ink)}.ds-dot{width:6px;height:6px;display:inline-block;border-radius:50%;background:currentColor;flex-shrink:0}"
    },
    {
      "name": "Evidence panel",
      "kind": "card",
      "refersTo": "product-card",
      "description": "A flat surface for real data, bordered rather than lifted.",
      "html": "<section class=\"ds-panel\"><h2>Price history</h2><p>Prices are recorded in the listing’s currency.</p></section>",
      "css": ".ds-panel{background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:var(--radius-card);padding:28px;font-family:var(--font-body);min-width:0}.ds-panel h2{font-size:1.5rem;font-weight:600;line-height:1.2;letter-spacing:-.02em;margin:0}.ds-panel p{font-size:1rem;line-height:1.6;color:var(--muted);margin:12px 0 0}"
    },
    {
      "name": "Native disclosure",
      "kind": "custom",
      "description": "A fine-rule disclosure with a visible rotating Lucide-style chevron.",
      "html": "<details class=\"ds-details\"><summary><span>How does tracking work?</span><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></summary><p>Watchtower records observed prices and availability from a product listing.</p></details>",
      "css": ".ds-details{border-bottom:1px solid var(--line);font-family:var(--font-body);color:var(--ink)}.ds-details summary{display:flex;align-items:center;justify-content:space-between;gap:24px;cursor:pointer;min-height:64px;padding:16px 0;font-size:1rem;font-weight:500;list-style:none}.ds-details summary::-webkit-details-marker{display:none}.ds-details summary svg{flex-shrink:0;color:var(--muted);transition:transform .16s}.ds-details[open]>summary svg{transform:rotate(180deg)}.ds-details summary:hover{color:var(--accent)}.ds-details summary:focus-visible{outline:3px solid var(--accent);outline-offset:4px}.ds-details p{padding:0 32px 24px 0;margin:0;color:var(--muted);font-size:.9375rem;line-height:1.7}@media(prefers-reduced-motion:reduce){.ds-details summary svg{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Price Observatory",
    "overview": "Watchtower is a price observatory for shoppers considering a purchase over time. Its interface presents observed prices, availability and explained assessments with enough context for users to make their own buying decision. The private watchlist and explicitly published snapshot have a visible boundary.\n\nThe visual language is precise and approachable: cool paper surfaces, ink-blue hierarchy and measured blue observation accents, measured grotesque headings and an open radar frame. Marketing introductions have an asymmetric rhythm; task screens use aligned evidence, short labels and predictable controls. Identity comes from the observation language rather than decorative sale urgency.",
    "keyCharacteristics": [
      "Radar frame and observation dots attached to real states.",
      "Tabular price notation, recorded currencies and dated evidence.",
      "Fine horizontal rules separating observations, choices and settings.",
      "Self-hosted typography and deliberately paired light and dark surfaces."
    ],
    "rules": [
      {
        "name": "The Observation Rule",
        "body": "Use the observation accent for chart evidence, link feedback and observation marks. Primary actions use the separate button token. Feedback uses its own semantic color and an explicit text label.",
        "section": "colors"
      },
      {
        "name": "The Evidence Rule",
        "body": "Show recorded currency, time and uncertainty beside the relevant value. Use tabular numbers for prices and compact measurements.",
        "section": "typography"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Ordinary surfaces use tone and fine borders. Dialogs alone use a large ambient shadow; hover feedback does not lift cards.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic CSS variables so every state retains the same role in both themes.",
      "Do keep price history, stock status and private/public boundaries explicit.",
      "Do use native controls and associated helper text; keep visible keyboard focus and task-specific confirmation labels.",
      "Do let mobile feed entries become compact lists and task forms use the available width.",
      "Do use Lucide SVG icons for meaningful actions and keep observation dots subordinate to text."
    ],
    "donts": [
      "Don't invent statistics, reviews, badges, retailer certainty or product capabilities.",
      "Don't add decorative punctuation to names, headings, controls or fragments.",
      "Don't add decorative arrows, emoji, glowing backgrounds or unrelated icon styles.",
      "Don't hide routine actions behind hover or use continuous radar sweeps and chart animation.",
      "Don't extend display type to task labels or replace accessible controls with clickable containers."
    ]
  }
}
